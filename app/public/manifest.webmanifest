{
  "name": "PlanMeasure AI",
  "short_name": "PlanMeasure",
  "description": "Door, window and opening measurements from architectural drawings - on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#2b2622",
  "theme_color": "#2b2622",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/zip": [".planmeasure"] } }]
}
